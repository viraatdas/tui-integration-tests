{
  "name": "tui-integration-tests",
  "version": "0.4.0",
  "description": "Screen-level integration tests for any terminal UI: plug in your binary, send real keystrokes through a real PTY, assert on what the user actually sees.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viraatdas/tui-integration-tests.git"
  },
  "homepage": "https://github.com/viraatdas/tui-integration-tests#readme",
  "bugs": "https://github.com/viraatdas/tui-integration-tests/issues",
  "keywords": [
    "tui",
    "terminal",
    "integration-testing",
    "e2e",
    "pty",
    "ratatui",
    "bubbletea",
    "textual",
    "curses",
    "screen-testing"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./harness/harness.mjs"
    },
    "./fetch-driver": "./harness/fetch-driver.mjs",
    "./reporter": "./harness/reporter.mjs"
  },
  "files": [
    "harness/",
    "pins.json",
    "examples/",
    "README.md",
    "LICENSE",
    "SETUP_PROMPT.md",
    "index.d.ts"
  ],
  "scripts": {
    "fetch-driver": "node harness/fetch-driver.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:report": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./harness/reporter.mjs --test-reporter-destination=tui-report.html tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./index.d.ts"
}